# Google Maps API Key
# Obtenha em: https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Configuration
# Obtenha em: Console do Firebase > Configurações do Projeto > Seus Aplicativos (Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS Configuration
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID_OTP=
VITE_EMAILJS_TEMPLATE_ID_OTP=
VITE_EMAILJS_SERVICE_ID_ORDER=
VITE_EMAILJS_TEMPLATE_ID_ORDER=

# Integração com a Pri (OpenRouter AI)
# Modelos usados (com fallback): deepseek/deepseek-v4-flash:free → google/gemma-4-31b-it:free
OPENROUTER_API_KEY=sua_chave_do_openrouter
